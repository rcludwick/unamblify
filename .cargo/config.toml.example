# Example of the .cargo/config.toml that scripts/train-env.sh writes.
# The real file is machine-specific (absolute paths) and gitignored.
#
# tch-rs 0.26 links libtorch 2.13.0 from the `torch==2.13.0` wheel that
# `just train-env` installs into .venv-torch. Two things have to be told to
# cargo: where libtorch is (LIBTORCH, resolved by torch-sys' build script
# to <dir>/include and <dir>/lib), and an rpath so the built binaries and
# test executables can load libtorch.{dylib,so} without DYLD_LIBRARY_PATH /
# LD_LIBRARY_PATH.

[env]
LIBTORCH = "/abs/path/to/unamblify/.venv-torch/lib/python3.12/site-packages/torch"
# Alternative when python from the venv is on PATH (what the spike used):
# LIBTORCH_USE_PYTORCH = "1"

# One block for the host target. macOS Apple Silicon:
[target.aarch64-apple-darwin]
rustflags = ["-C", "link-arg=-Wl,-rpath,/abs/path/to/unamblify/.venv-torch/lib/python3.12/site-packages/torch/lib"]

# Linux x86-64 (CPU, CUDA cu128 or ROCm 6.4 wheels — same layout):
# [target.x86_64-unknown-linux-gnu]
# rustflags = ["-C", "link-arg=-Wl,-rpath,/abs/path/to/unamblify/.venv-torch/lib/python3.12/site-packages/torch/lib"]
